# Copy this file to .env.local and fill it in. .env.local is git-ignored: never commit real values.
# On Vercel (or any host), add the same variables in the project's environment settings.
# Setup steps are in README.md ("Setup after cloning").

# ---------------------------------------------------------------------------------------------
# Supabase (REQUIRED). Server-side only: never prefix these with NEXT_PUBLIC_.
# Dashboard: Project Settings -> API (or "API Keys").
# ---------------------------------------------------------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Publishable (anon) key, used only to read the admin sign-in session.
SUPABASE_PUBLISHABLE_KEY=
# Secret (service role) key. Full database access: keep it private and rotate it if it leaks.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------------------------
# Admin panel (REQUIRED to use /admin)
# ---------------------------------------------------------------------------------------------
# Comma-separated emails allowed into /admin. Each must also exist under
# Supabase -> Authentication -> Users (email + password, "Auto confirm" on).
ADMIN_EMAILS=

# ---------------------------------------------------------------------------------------------
# Upstash Redis (OPTIONAL). Shared cache and rate limiting. Without these two the site reads
# Supabase directly and rate-limits per server instance, which still works.
# Console: Upstash -> your database -> REST API (use the normal token, not the read-only one).
# ---------------------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------------------------
# Keep-alive (RECOMMENDED on free tiers). Protects /api/keepalive, which the GitHub Actions workflow
# calls every 3 days so the free Supabase and Upstash projects never go idle and pause.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Use the same value as the KEEPALIVE_SECRET repository secret on GitHub.
# ---------------------------------------------------------------------------------------------
KEEPALIVE_SECRET=

# ---------------------------------------------------------------------------------------------
# Site (OPTIONAL)
# ---------------------------------------------------------------------------------------------
# Override of the public site URL (no trailing slash). Defaults to siteConfig.siteUrl.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console verification code (the content value of the meta tag).
# NEXT_PUBLIC_GSC_VERIFICATION=
